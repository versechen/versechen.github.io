---
interface Props { href: string }
const { href } = Astro.props;

// Elliptical petals stay readable at 26px; notched paths turn into noise.
const blossom = (x: number, y: number, s = 1) =>
  `<g class="spring-blossom" transform="translate(${x} ${y}) scale(${s})"><g class="spring-tint">${
    [0, 72, 144, 216, 288].map((a) => `<ellipse rx="2.2" ry="5.2" cy="-4.2" transform="rotate(${a})"/>`).join('')
  }</g><circle class="spring-amber" r="1.6" fill="currentColor" stroke="none"/></g>`;
const flake = (x: number, y: number, rot = 0, s = 1) =>
  `<ellipse class="spring-blossom spring-tint" transform="translate(${x} ${y}) rotate(${rot}) scale(${s})" rx="2.3" ry="4"/>`;

const shapes: Record<string, string> = {
  // 春日序章：一枝樱。
  '/': `
    <path class="spring-bark" d="M28 30C21 24 16 20 12 12"/>
    ${blossom(12, 11, 1.05)}
    ${flake(25, 8, 32, .9)}
  `,
  // 风中札记：三片花瓣随风。
  '/blog': `
    ${flake(9, 10, -38, 1.15)}
    ${flake(17, 18, 28, 1)}
    ${flake(24, 8, 8, .88)}
    <path class="spring-slate" d="M5 26c8-2 14 0 22 4"/>
  `,
  // 书页生香：摊开的书上落着一朵花。
  '/reading': `
    <path class="spring-paper" d="M3 12c5-1 9 0 13 3 4-3 8-4 13-3v15c-5-1-9 0-13 3-4-3-8-4-13-3Z"/>
    <path d="M16 15v15"/>
    ${blossom(22, 21, .78)}
    ${flake(8, 19, 22, .8)}
  `,
  // 新枝初长：嫩枝上刚开的花。
  '/projects': `
    <path class="spring-bark" d="M16 30V11"/>
    <path class="spring-sage spring-tint" d="M16 19c-5-2-7-1-8 3M16 16c5-2 7-1 8 3"/>
    ${blossom(16, 9, .92)}
  `,
  // 晴日慢行：日光里的落花。
  '/life': `
    <circle class="spring-amber spring-tint" cx="23" cy="8" r="5"/>
    <path class="spring-amber" d="M23 1.6v1.5M29.4 8H31"/>
    <path class="spring-sage" d="M3 27c8-5 14-5 26 1"/>
    ${flake(8, 14, -22, 1)}
    ${flake(15, 20, 30, .85)}
  `,
  // 拾光成笺：笺纸上的压花。
  '/notes': `
    <path class="spring-paper" d="M8 4h15a2 2 0 0 1 2 2v22H10a2 2 0 0 1-2-2V4Z"/>
    <path d="M10 4v22"/>
    ${blossom(17, 15, .86)}
  `,
  // 春山来信：两朵花相向。
  '/friends': `
    ${blossom(11, 16, 1)}
    ${blossom(21.5, 12.5, .78)}
  `,
  // 见字如面：花树下的小路。
  '/about': `
    <path class="spring-bark" d="M4 11C12 6 18 9 28 5"/>
    <path class="spring-sage spring-tint" d="M2 26c8-7 14-7 28 2v4H2Z"/>
    <path d="M12 27c3-5 7-6 11-3"/>
    ${blossom(21, 9, .9)}
  `,
};
---

<svg class="sakura-nav-icon" viewBox="0 0 32 32" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <Fragment set:html={shapes[href] ?? shapes['/']} />
</svg>

<style>
  .sakura-nav-icon {
    --spring-sage: #6b846d;
    --spring-blossom: #c4788a;
    --spring-amber: #c4a06a;
    --spring-bark: #927967;
    --spring-slate: #8a7a86;
    --spring-paper: #fbf7f0;
    display: block;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    overflow: visible;
    color: #8a6d76;
    transition: translate .25s ease;
  }

  .sakura-nav-icon :global(.spring-sage) { color: var(--spring-sage); stroke: var(--spring-sage); }
  .sakura-nav-icon :global(.spring-blossom) { color: var(--spring-blossom); stroke: var(--spring-blossom); }
  .sakura-nav-icon :global(.spring-amber) { color: var(--spring-amber); stroke: var(--spring-amber); }
  .sakura-nav-icon :global(.spring-bark) { color: var(--spring-bark); stroke: var(--spring-bark); }
  .sakura-nav-icon :global(.spring-slate) { color: var(--spring-slate); stroke: var(--spring-slate); }
  .sakura-nav-icon :global(.spring-tint) { fill: currentColor; fill-opacity: .38; }
  .sakura-nav-icon :global(.spring-paper) { fill: var(--spring-paper); }

  :global(html.dark) .sakura-nav-icon {
    --spring-sage: #a2b89e;
    --spring-blossom: #e4b7c6;
    --spring-amber: #e0c48a;
    --spring-bark: #baa28f;
    --spring-slate: #c9b4c0;
    --spring-paper: #252334;
    color: #d4c0c6;
  }

  :global(html[data-visual-theme='poetize']) .sakura-nav-icon { display: none; }
</style>
