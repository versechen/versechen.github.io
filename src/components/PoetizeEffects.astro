<canvas id="coastal-sea" aria-hidden="true"></canvas>
<canvas id="coastal-tide" aria-hidden="true" hidden></canvas>
<div class="poetize-reading-progress" aria-hidden="true"></div>
<div class="poetize-tools" aria-label="阅读工具">
  <button id="poetize-effects-toggle" aria-label="关闭海浪与海鸥动画" aria-pressed="true" title="海浪、海鸥与波光动画"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 9.5c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 15c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"/><path d="m16.5 4 1.5-1 1.5 1" /></svg></button>
  <button id="poetize-focus-toggle" aria-label="开启专注阅读" aria-pressed="false" title="专注阅读"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h7a2 2 0 0 1 2 2v14a3 3 0 0 0-3-3H3Zm18 0h-7a2 2 0 0 0-2 2v14a3 3 0 0 1 3-3h6Z"/></svg></button>
  <button id="poetize-top" aria-label="返回顶部" title="返回顶部"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 7-7 7 7M12 5v15"/></svg></button>
</div>
<dialog class="poetize-lightbox" id="poetize-lightbox" aria-label="文章封面大图">
  <button type="button" class="poetize-lightbox-close" aria-label="关闭封面大图">×</button>
  <img alt="" />
</dialog>
<script>
  import { initCoastalBoats } from '../lib/coastal-boats';
  import { initCoastalSea } from '../lib/coastal-sea';
  import { initCoastalTide } from '../lib/coastal-tide';

  const root = document.documentElement;
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const effectsButton = document.querySelector<HTMLButtonElement>('#poetize-effects-toggle');
  const focusButton = document.querySelector<HTMLButtonElement>('#poetize-focus-toggle');
  const topButton = document.querySelector<HTMLButtonElement>('#poetize-top');
  const canvas = document.querySelector<HTMLCanvasElement>('#coastal-sea');
  let enabled = true;
  try { enabled = localStorage.getItem('poetize-effects') !== 'off'; } catch {}
  const eligible = () => root.dataset.visualTheme === 'poetize' && !document.querySelector('#notes-app, .docs-shell, .editor-demo') && enabled && !motion.matches && root.dataset.readingFocus !== 'true';
  const active = () => eligible() && !document.hidden;
  // Reading and filtering surfaces keep drifting bubbles away from text/forms; gulls and glints stay inside the hero painting.
  const sea = canvas ? initCoastalSea(canvas, { ambient: !document.querySelector('.blog-sidebar, .article-main') }) : null;
  if (canvas && !sea) canvas.hidden = true;
  const boatCanvas = document.querySelector<HTMLCanvasElement>('.coastal-boats');
  const boats = boatCanvas ? initCoastalBoats(boatCanvas) : null;
  const tideCanvas = document.querySelector<HTMLCanvasElement>('#coastal-tide');
  const tide = tideCanvas ? initCoastalTide(tideCanvas, { active: eligible }) : null;
  if (!tide) delete root.dataset.coastalArrival;
  const sync = () => {
    const running = active();
    root.dataset.poetizeMotion = running ? 'on' : 'off';
    if (!running) document.querySelectorAll('.poetize-arriving').forEach(el => el.classList.remove('poetize-arriving'));
    effectsButton?.setAttribute('aria-pressed', String(enabled && !motion.matches));
    effectsButton?.setAttribute('aria-label', enabled ? '关闭海浪与海鸥动画' : '开启海浪与海鸥动画');
    if (effectsButton) { effectsButton.disabled = motion.matches; effectsButton.title = motion.matches ? '已遵循系统减少动态效果设置' : '海浪、海鸥与波光动画'; }
    sea?.setActive(running); tide?.setActive(running); boats?.setActive(running);
  };
  effectsButton?.addEventListener('click', () => { enabled = !enabled; try { localStorage.setItem('poetize-effects', enabled ? 'on' : 'off'); } catch {} sync(); });
  focusButton?.addEventListener('click', () => {
    const focused = root.dataset.readingFocus !== 'true'; root.dataset.readingFocus = String(focused);
    focusButton.setAttribute('aria-pressed', String(focused)); focusButton.setAttribute('aria-label', focused ? '退出专注阅读' : '开启专注阅读');
    sync(); window.dispatchEvent(new Event('resize'));
    if (focused) document.querySelector('.article-main')?.scrollIntoView({ behavior: motion.matches ? 'auto' : 'smooth', block: 'start' });
  });
  topButton?.addEventListener('click', () => { window.scrollTo({top:0, behavior:motion.matches ? 'auto' : 'smooth'}); });
  const updateProgress = () => {
    if (topButton) topButton.hidden = scrollY < 300;
    const article = document.querySelector<HTMLElement>('.article-main');
    const start = article ? article.getBoundingClientRect().top + scrollY - 90 : 0;
    const end = article ? start + article.offsetHeight - innerHeight + 90 : document.documentElement.scrollHeight - innerHeight;
    root.style.setProperty('--reading-progress', String(Math.max(0, Math.min(1, (scrollY - start) / Math.max(1, end - start)))));
  };
  let scrollFrame = 0;
  window.addEventListener('scroll', () => { if (!scrollFrame) scrollFrame = requestAnimationFrame(() => { updateProgress(); scrollFrame = 0; }); }, { passive:true });
  window.addEventListener('resize', () => { sea?.resize(); tide?.resize(); boats?.resize(); updateProgress(); });
  document.addEventListener('visibilitychange', sync); motion.addEventListener('change', sync);
  const themeObserver = new MutationObserver(sync);
  const observeTheme = () => themeObserver.observe(root, {attributes:true, attributeFilter:['data-visual-theme']});
  observeTheme();
  // Animate once on arrival, without hiding content before JS or moving layout.
  const arrivals = new IntersectionObserver(entries => entries.forEach(entry => {
    if (!entry.isIntersecting || !active()) return;
    entry.target.classList.add('poetize-arriving');
    arrivals.unobserve(entry.target);
  }), { threshold: .12 });
  const arrivalTargets = document.querySelectorAll('.poetize-profile, .poetize-article-intro, .book-card, .project-card, .life-card, .tag-card, .post-row');
  arrivalTargets.forEach(el => {
    arrivals.observe(el);
    el.addEventListener('animationend', () => el.classList.remove('poetize-arriving'));
  });
  window.addEventListener('pagehide', () => {
    sea?.setActive(false); boats?.setActive(false);
    cancelAnimationFrame(scrollFrame); scrollFrame = 0;
    themeObserver.disconnect(); arrivals.disconnect();
  });
  window.addEventListener('pageshow', event => {
    if (event.persisted) { observeTheme(); sync(); updateProgress(); }
  });
  sync(); updateProgress();
  const dialog = document.querySelector<HTMLDialogElement>('#poetize-lightbox');
  const lightboxImage = dialog?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('.poetize-cover-button').forEach(button => button.addEventListener('click', () => {
    const source = button.querySelector('img');
    if (!dialog || !source || !lightboxImage) return;
    lightboxImage.src = source.src; lightboxImage.alt = source.alt; dialog.showModal();
  }));
  dialog?.querySelector('button')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
</script>
