---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

// footnote-label 是 GFM 自动生成的视觉隐藏标题，不应出现在目录中。
const headings = Astro.props.headings.filter(
  (heading) =>
    heading.depth >= 2 && heading.depth <= 4 && heading.slug !== 'footnote-label'
);
---

{headings.length > 1 && (
  <aside class="toc" id="article-toc" data-available="false" aria-label="文章目录">
    <button type="button" class="toc-trigger" id="article-toc-trigger" aria-controls="article-toc-panel" aria-expanded="false" aria-label="打开文章目录"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M3 6h1M3 12h1M3 18h1"/></svg></button>

    <div class="toc-panel" id="article-toc-panel" aria-hidden="true" inert>

      <div class="toc-head">
        <p class="toc-title">本文目录</p><button type="button" class="toc-close" id="article-toc-close" aria-label="关闭目录">×</button>
        <button type="button" class="toc-pin" id="article-toc-pin" aria-pressed="false" aria-label="固定目录" title="固定目录">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 17v5M9 10.8a2 2 0 0 1-1.1 1.8l-1.8.9A2 2 0 0 0 5 15.2V17h14v-1.8a2 2 0 0 0-1.1-1.8l-1.8-.9a2 2 0 0 1-1.1-1.8V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/>
          </svg>
        </button>
      </div>
      <nav>
        <ol>
          {headings.map((heading) => (
            <li class:list={[`depth-${heading.depth}`]}>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </aside>
)}

<script>
  import { tocBounds } from '../lib/toc-geometry';

  const toc = document.getElementById('article-toc');
  const panel = document.getElementById('article-toc-panel');
  const trigger = document.getElementById('article-toc-trigger');
  const pin = document.getElementById('article-toc-pin');
  const close = document.getElementById('article-toc-close');
  if (toc && panel && trigger && pin && close) {
    // Versioned intent: old automatic/gutter pin choices must not reopen the new UI.
    const key = 'codeverse.articleToc.pin.v2';
    let state: 'collapsed' | 'temporary' | 'pinned' = 'collapsed';
    try { if (localStorage.getItem(key) === '1') state = 'pinned'; } catch {}
    let hover = false, keyboard = false, intent = 0, hide = 0, frame = 0;
    let bounds = { top: 0, bottom: 0, height: 0, available: false };
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const headings = links.map(link => document.getElementById(link.dataset.tocLink ?? ''));
    const held = () => hover || (keyboard && panel.contains(document.activeElement));
    const render = () => {
      const open = bounds.available && state !== 'collapsed';
      toc.dataset.state = state;
      toc.dataset.available = String(bounds.available);
      toc.classList.toggle('is-open', open);
      toc.classList.toggle('is-pinned', state === 'pinned');
      panel.inert = !open;
      panel.setAttribute('aria-hidden', String(!open));
      trigger.inert = !bounds.available;
      trigger.setAttribute('aria-hidden', String(!bounds.available));
      trigger.setAttribute('aria-expanded', String(open));
      trigger.setAttribute('aria-label', open ? '关闭文章目录' : '打开文章目录');
      pin.setAttribute('aria-pressed', String(state === 'pinned'));
      pin.setAttribute('aria-label', state === 'pinned' ? '取消固定目录' : '固定目录');
      pin.title = state === 'pinned' ? '取消固定目录' : '固定目录';

    };
    const reset = () => { clearTimeout(hide); };
    const place = () => {
      const main = document.querySelector<HTMLElement>('.article-main');
      if(!main) return;
      const box = main.getBoundingClientRect();
      const nav = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-height')) || 64;
      bounds = tocBounds(box, innerHeight, nav);
      toc.style.setProperty('--toc-top', `${bounds.top}px`);
      toc.style.setProperty('--toc-height', `${bounds.height}px`);
      toc.style.setProperty('--toc-trigger-top', `${Math.max(bounds.top, Math.min(innerHeight * .45, bounds.bottom - 44))}px`);
      if (!bounds.available) {
        clearTimeout(intent); clearTimeout(hide); hover = false;
        // Pin is saved intent, never permission to float outside the article.
        if (state === 'temporary') state = 'collapsed';
        if (toc.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
      }
      const width = Math.min(236, innerWidth - 32);
      const gutter = box.left >= width + 32 && innerWidth > 768;
      const left = gutter ? box.left - width - 16 : Math.max(8, box.left);
      toc.style.setProperty('--toc-left', `${left}px`);
      toc.style.setProperty('--toc-width', `${width}px`);
      toc.style.setProperty('--toc-trigger-left', `${gutter ? box.left - 22 : Math.max(4,box.left - 8)}px`);
      toc.dataset.layout = gutter ? 'gutter' : 'overlay';
    };
    const leave = () => {
      clearTimeout(intent); clearTimeout(hide);
      if(state === 'temporary' && !held()) hide = window.setTimeout(() => { if(state === 'temporary' && !held()) collapse(); },180);
    };
    const persist = () => { try { localStorage.setItem(key, state === 'pinned' ? '1' : '0'); } catch {} };
    const collapse = () => {
      clearTimeout(intent);
      if (bounds.available && panel.contains(document.activeElement)) trigger.focus({preventScroll:true});
      state = 'collapsed'; reset(); persist(); render();
    };
    const reveal = () => {
      clearTimeout(intent); place();
      if (!bounds.available) { render(); return; }
      if(state !== 'pinned') state = 'temporary'; reset(); render();
    };
    let pointer: { x:number; y:number } | null = null;
    const sense = () => {
      if(!bounds.available) {
        hover = false; leave(); return;
      }
      if(!pointer || !matchMedia('(hover:hover) and (pointer:fine)').matches) return;
      const main = document.querySelector<HTMLElement>('.article-main');
      if(!main) return;
      const box = main.getBoundingClientRect();
      const target = document.elementFromPoint(pointer.x,pointer.y);
      const inVerticalBounds = pointer.y >= bounds.top && pointer.y <= bounds.bottom;
      const inPanel = state !== 'collapsed' && inVerticalBounds && !!target && panel.contains(target);
      const inReadingGutter = pointer.x >= 0 && pointer.x < box.left &&
        inVerticalBounds &&
        !target?.closest('header,footer,[role="navigation"]');
      const next = inPanel || inReadingGutter;
      if(next === hover) return;
      hover = next;
      if(next) { reset(); if(state === 'collapsed') intent = window.setTimeout(() => { place(); sense(); if (hover) reveal(); },100); }
      else leave();
    };
    document.addEventListener('pointermove', event => {
      if(event.pointerType !== 'mouse') return;
      pointer = {x:event.clientX,y:event.clientY}; sense();
    }, {passive:true});
    const exitPointer = () => { pointer = null; hover = false; leave(); };
    document.documentElement.addEventListener('pointerleave', exitPointer);
    window.addEventListener('blur', exitPointer);
    document.addEventListener('keydown', event => { if(event.key === 'Tab') keyboard = true; });
    toc.addEventListener('pointerdown', () => { keyboard = false; });
    trigger.addEventListener('click', event => {
      clearTimeout(intent);
      place();
      if (!bounds.available) { render(); return; }
      if(state !== 'collapsed') collapse();
      else { keyboard = event.detail === 0; reveal(); if(keyboard) close.focus({preventScroll:true}); }
    });
    close.addEventListener('click', collapse);
    panel.addEventListener('focusin', reset);
    panel.addEventListener('focusout', () => requestAnimationFrame(leave));
    pin.addEventListener('click', () => {
      place();
      if (!bounds.available) { render(); return; }
      state = state === 'pinned' ? 'temporary' : 'pinned'; reset(); persist(); render(); leave();
    });
    toc.addEventListener('keydown', event => { if(event.key === 'Escape' && state !== 'collapsed') { event.preventDefault(); collapse(); } });
    const highlight = () => {
      const offset = (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-height')) || 64) + 24;
      let active = headings.find(h => h);
      for(const heading of headings) if(heading && heading.getBoundingClientRect().top <= offset + 8) active = heading;
      links.forEach(link => { const yes = link.dataset.tocLink === active?.id; link.classList.toggle('active', yes); if(yes) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current'); });
    };
    const update = () => {
      frame = 0;
      place(); sense(); render(); highlight();
    };
    const schedule = () => { if(!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, {passive:true});
    window.addEventListener('resize', schedule);
    const geometryObserver = new ResizeObserver(schedule);
    const reading = document.querySelector('.article-main');
    if(reading) geometryObserver.observe(reading);
    window.addEventListener('hashchange', schedule);
    window.addEventListener('pageshow', schedule);
    place(); render(); highlight();
  }
</script>

<style>
  /* Geometry-based pointer sensing adds no hit-test overlay or reading column. */
  .toc { position:fixed; inset:0 auto 0 0; z-index:30; pointer-events:none; }
  /* Desktop entry is available to keyboard/AT, with no pointer target or visible marker. */
  .toc-trigger { position:fixed; left:var(--toc-trigger-left,8px); top:var(--toc-trigger-top,45vh); width:1px; height:1px; padding:0; overflow:hidden;clip-path:inset(50%); border:0; background:var(--surface); color:var(--text-muted);pointer-events:none; }
  .toc-trigger:focus-visible { width:44px;height:44px;clip-path:none;overflow:visible;display:grid;place-items:center;border:1px solid var(--border);border-radius:8px;pointer-events:auto; }
  .toc-panel { position:fixed; box-sizing:border-box; top:var(--toc-top,80px); left:var(--toc-left,8px); width:var(--toc-width,236px); max-height:var(--toc-height,0px); overflow:auto; overscroll-behavior:contain; padding:1.05rem 1.1rem 1.15rem; border:1px solid var(--border); border-radius:18px; background:var(--surface); box-shadow:var(--shadow-lg); opacity:0; visibility:hidden; pointer-events:none; transform:translateX(-8px); transition:opacity .16s linear,transform .16s ease; }
  .toc .toc-panel { transition:opacity .16s linear,transform .16s ease; }
  .toc.is-open .toc-panel { opacity:1; visibility:visible; pointer-events:auto; transform:none; }
  .toc[data-available='false'] .toc-trigger { visibility:hidden; pointer-events:none; }
  .toc-close { margin-left:auto; border:0; background:transparent; color:var(--text-muted); cursor:pointer; font-size:24px; min-width:44px; min-height:44px; }
  .toc :is(button,a):focus-visible { outline:2px solid var(--primary); outline-offset:3px; }
  @media(prefers-reduced-motion:reduce) { .toc .toc-panel { transition:none; } }

  .toc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .toc-title {
    margin: 0;
    color: var(--text-1);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .toc-pin {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition), background var(--transition);
  }

  .toc-pin:hover {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }

  .toc-pin[aria-pressed='true'] {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 16%, transparent);
  }

  .toc-pin[aria-pressed='true'] svg {
    fill: currentColor;
  }

  nav {
    margin-top: 0.75rem;
  }

  ol {
    display: grid;
    gap: 0.42rem;
    list-style: none;
  }

  li {
    min-width: 0;
  }

  li.depth-3 {
    padding-left: 0.75rem;
  }

  li.depth-4 {
    padding-left: 1.5rem;
  }

  a {
    display: block;
    padding: 0.12rem 0 0.12rem 0.7rem;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.55;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--transition), border-color var(--transition);
  }

  a:hover,
  a.active {
    border-left-color: var(--primary);
    color: var(--primary);
  }

  @media(pointer:coarse), (max-width:768px) {
    .toc-trigger { width:44px;height:44px;clip-path:none;overflow:visible;display:grid;place-items:center;pointer-events:auto;border-radius:8px;background:var(--surface);border:1px solid var(--border); }
    .toc-trigger svg { opacity:1; }
    .toc-pin { width:44px;height:44px; }
  }
</style>
