---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

// footnote-label 是 GFM 自动生成的视觉隐藏标题，不应出现在目录中。
const headings = Astro.props.headings.filter(
  (heading) =>
    heading.depth >= 2 && heading.depth <= 4 && heading.slug !== 'footnote-label'
);
---

{headings.length > 1 && (
  <aside class="toc" id="article-toc" aria-label="文章目录">
    <div class="toc-panel" id="article-toc-panel">
      <div class="toc-head">
        <p class="toc-title">本文目录</p>
        <button type="button" class="toc-pin" id="article-toc-pin" aria-pressed="false" aria-label="固定目录" title="固定目录">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 17v5M9 10.8a2 2 0 0 1-1.1 1.8l-1.8.9A2 2 0 0 0 5 15.2V17h14v-1.8a2 2 0 0 0-1.1-1.8l-1.8-.9a2 2 0 0 1-1.1-1.8V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/>
          </svg>
        </button>
      </div>
      <nav>
        <ol>
          {headings.map((heading) => (
            <li class:list={[`depth-${heading.depth}`]}>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </aside>
)}

<script>
  const toc = document.getElementById('article-toc');
  const panel = document.getElementById('article-toc-panel');
  const pin = document.getElementById('article-toc-pin');
  const intro = document.querySelector('.post-header');
  const main = document.querySelector('.article-main');
  const PIN_KEY = 'codeverse.articleToc.pinned';

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const headings = tocLinks
    .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  if (headings.length > 0) {
    const activate = (id: string) => {
      tocLinks.forEach((link) => {
        const active = link.dataset.tocLink === id;
        link.classList.toggle('active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target.id) activate(visible[0].target.id);
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );

    headings.forEach((heading) => observer.observe(heading));
  }

  if (toc && panel && pin) {
    let atIntro = true;
    let hovering = false;
    let hideTimer = 0;
    let pinned = false;
    try {
      pinned = localStorage.getItem(PIN_KEY) === '1';
    } catch {
      pinned = false;
    }

    const desktop = () => window.matchMedia('(min-width: 769px)').matches;

    const place = () => {
      if (!desktop() || !main) return;
      const left = Math.max(24, Math.round(main.getBoundingClientRect().left));
      toc.style.setProperty('--toc-left', `${left}px`);
      toc.style.setProperty('--toc-zone', `${Math.max(140, left + 88)}px`);
    };

    const render = () => {
      const open = !desktop() || pinned || atIntro || hovering;
      toc.classList.toggle('is-open', open);
      toc.classList.toggle('is-pinned', pinned);
      panel.setAttribute('aria-hidden', String(!open));
      pin.setAttribute('aria-pressed', String(pinned));
      pin.setAttribute('aria-label', pinned ? '取消固定目录' : '固定目录');
      pin.title = pinned ? '取消固定' : '固定';
    };

    const setHover = (next: boolean) => {
      window.clearTimeout(hideTimer);
      if (next) {
        hovering = true;
        render();
        return;
      }
      hideTimer = window.setTimeout(() => {
        hovering = false;
        render();
      }, 160);
    };

    const setPinned = (next: boolean) => {
      pinned = next;
      try {
        localStorage.setItem(PIN_KEY, next ? '1' : '0');
      } catch {
        // 存不住也只影响这一次
      }
      render();
    };

    const inZone = (event: MouseEvent) => {
      const zone = Number.parseFloat(getComputedStyle(toc).getPropertyValue('--toc-zone')) || 140;
      return event.clientX <= zone || toc.contains(event.target as Node);
    };

    pin.addEventListener('click', () => setPinned(!pinned));
    document.addEventListener('mousemove', (event) => setHover(inZone(event)), { passive: true });
    toc.addEventListener('focusin', () => setHover(true));
    toc.addEventListener('focusout', (event) => {
      if (!toc.contains(event.relatedTarget as Node | null)) setHover(false);
    });

    if (intro) {
      const introObserver = new IntersectionObserver(
        (entries) => {
          atIntro = Boolean(entries[0]?.isIntersecting);
          render();
        },
        { threshold: 0, rootMargin: '-64px 0px 0px 0px' },
      );
      introObserver.observe(intro);
    }

    window.addEventListener('resize', () => {
      place();
      render();
    });
    place();
    render();
  }
</script>

<style>
  /* 浮在正文左侧，不占栏宽。热区覆盖左缘到正文边，移动更灵敏。 */
  .toc {
    --toc-left: 24px;
    --toc-zone: 140px;
    position: fixed;
    top: var(--nav-height);
    left: 0;
    bottom: 0;
    z-index: 20;
    width: var(--toc-zone);
    pointer-events: none;
  }

  .toc-panel {
    position: absolute;
    top: 1.5rem;
    left: var(--toc-left);
    width: min(252px, calc(100vw - 3rem));
    max-height: calc(100vh - var(--nav-height) - 3rem);
    overflow: auto;
    padding: 1.05rem 1.1rem 1.15rem;
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, var(--glass-bg) 88%, var(--bg));
    backdrop-filter: blur(20px) saturate(1.2);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-8px);
    transition: opacity 0.24s ease, transform 0.24s ease;
  }

  .toc.is-open .toc-panel {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .toc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .toc-title {
    margin: 0;
    color: var(--text-1);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .toc-pin {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition), background var(--transition);
  }

  .toc-pin:hover {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }

  .toc-pin[aria-pressed='true'] {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 16%, transparent);
  }

  .toc-pin[aria-pressed='true'] svg {
    fill: currentColor;
  }

  nav {
    margin-top: 0.75rem;
  }

  ol {
    display: grid;
    gap: 0.42rem;
    list-style: none;
  }

  li {
    min-width: 0;
  }

  li.depth-3 {
    padding-left: 0.75rem;
  }

  li.depth-4 {
    padding-left: 1.5rem;
  }

  a {
    display: block;
    padding: 0.12rem 0 0.12rem 0.7rem;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.55;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--transition), border-color var(--transition);
  }

  a:hover,
  a.active {
    border-left-color: var(--primary);
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .toc {
      position: static;
      width: auto;
      margin-bottom: 1.5rem;
      pointer-events: auto;
    }

    .toc-panel {
      position: static;
      width: auto;
      max-height: none;
      opacity: 1;
      pointer-events: auto;
      transform: none;
      box-shadow: none;
    }

    .toc-pin {
      display: none;
    }
  }
</style>
