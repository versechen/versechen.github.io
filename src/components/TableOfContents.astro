---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

// footnote-label 是 GFM 自动生成的视觉隐藏标题，不应出现在目录中。
const headings = Astro.props.headings.filter(
  (heading) =>
    heading.depth >= 2 && heading.depth <= 4 && heading.slug !== 'footnote-label'
);
---

{headings.length > 1 && (
  <aside class="toc" id="article-toc" aria-label="文章目录">
    <div class="toc-hotzone" id="article-toc-hotzone" aria-hidden="true"></div>
    <div class="toc-panel" id="article-toc-panel">
      <div class="toc-head">
        <p class="toc-title">本文目录</p>
        <button type="button" class="toc-pin" id="article-toc-pin" aria-pressed="false" aria-label="固定目录">
          固定
        </button>
      </div>
      <nav>
        <ol>
          {headings.map((heading) => (
            <li class:list={[`depth-${heading.depth}`]}>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </aside>
)}

<script>
  const toc = document.getElementById('article-toc');
  const panel = document.getElementById('article-toc-panel');
  const hotzone = document.getElementById('article-toc-hotzone');
  const pin = document.getElementById('article-toc-pin');
  const intro = document.querySelector('.post-header');
  const PIN_KEY = 'codeverse.articleToc.pinned';

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const headings = tocLinks
    .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  if (headings.length > 0) {
    const activate = (id: string) => {
      tocLinks.forEach((link) => {
        const active = link.dataset.tocLink === id;
        link.classList.toggle('active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target.id) activate(visible[0].target.id);
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );

    headings.forEach((heading) => observer.observe(heading));
  }

  if (toc && panel && hotzone && pin) {
    let atIntro = true;
    let hovering = false;
    let pinned = false;
    try {
      pinned = localStorage.getItem(PIN_KEY) === '1';
    } catch {
      pinned = false;
    }

    const desktop = () => window.matchMedia('(min-width: 769px)').matches;

    const render = () => {
      const open = !desktop() || pinned || atIntro || hovering;
      toc.classList.toggle('is-open', open);
      toc.classList.toggle('is-pinned', pinned);
      panel.setAttribute('aria-hidden', String(!open));
      pin.setAttribute('aria-pressed', String(pinned));
      pin.textContent = pinned ? '取消固定' : '固定';
      pin.setAttribute('aria-label', pinned ? '取消固定目录' : '固定目录');
    };

    const setPinned = (next: boolean) => {
      pinned = next;
      try {
        localStorage.setItem(PIN_KEY, next ? '1' : '0');
      } catch {
        // 存不住也只影响这一次
      }
      render();
    };

    pin.addEventListener('click', () => setPinned(!pinned));
    toc.addEventListener('mouseenter', () => {
      hovering = true;
      render();
    });
    toc.addEventListener('mouseleave', () => {
      hovering = false;
      render();
    });
    toc.addEventListener('focusin', () => {
      hovering = true;
      render();
    });
    toc.addEventListener('focusout', (event) => {
      if (!toc.contains(event.relatedTarget as Node | null)) {
        hovering = false;
        render();
      }
    });

    if (intro) {
      const introObserver = new IntersectionObserver(
        (entries) => {
          atIntro = Boolean(entries[0]?.isIntersecting);
          render();
        },
        { threshold: 0, rootMargin: '-64px 0px 0px 0px' },
      );
      introObserver.observe(intro);
    }

    window.addEventListener('resize', render);
    render();
  }
</script>

<style>
  /* 浮在页面左边，不占正文栏宽，伸缩不会推动文章。 */
  .toc {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    bottom: 0;
    z-index: 20;
    width: 28px;
    pointer-events: none;
  }

  .toc-hotzone {
    position: absolute;
    inset: 0;
    pointer-events: auto;
  }

  .toc-panel {
    position: absolute;
    top: 1.25rem;
    left: 1rem;
    width: min(260px, calc(100vw - 2rem));
    max-height: calc(100vh - var(--nav-height) - 2.5rem);
    overflow: auto;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--glass-bg);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-12px);
    transition: opacity 0.28s ease, transform 0.28s ease;
  }

  .toc.is-open .toc-panel {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .toc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .toc-title {
    margin: 0;
    color: var(--text-1);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .toc-pin {
    flex: none;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }

  .toc-pin:hover,
  .toc-pin[aria-pressed='true'] {
    color: var(--primary);
    border-color: color-mix(in srgb, var(--primary) 40%, var(--border));
    background: color-mix(in srgb, var(--primary) 10%, transparent);
  }

  nav {
    margin-top: 0.8rem;
  }

  ol {
    display: grid;
    gap: 0.5rem;
    list-style: none;
  }

  li {
    min-width: 0;
  }

  li.depth-3 {
    padding-left: 0.75rem;
  }

  li.depth-4 {
    padding-left: 1.5rem;
  }

  a {
    display: block;
    padding-left: 0.65rem;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.5;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--transition), border-color var(--transition);
  }

  a:hover,
  a.active {
    border-left-color: var(--primary);
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .toc {
      position: static;
      width: auto;
      margin-bottom: 1.5rem;
      pointer-events: auto;
    }

    .toc-hotzone {
      display: none;
    }

    .toc-panel {
      position: static;
      width: auto;
      max-height: none;
      opacity: 1;
      pointer-events: auto;
      transform: none;
      box-shadow: none;
    }

    .toc-pin {
      display: none;
    }
  }
</style>
