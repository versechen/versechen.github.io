---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

// footnote-label 是 GFM 自动生成的视觉隐藏标题，不应出现在目录中。
const headings = Astro.props.headings.filter(
  (heading) =>
    heading.depth >= 2 && heading.depth <= 4 && heading.slug !== 'footnote-label'
);
---

{headings.length > 1 && (
  <aside class="toc" id="article-toc" aria-label="文章目录">
    <button type="button" class="toc-trigger" id="article-toc-trigger" aria-controls="article-toc-panel" aria-expanded="false" aria-label="打开文章目录">目录</button>
    <div class="toc-panel" id="article-toc-panel" aria-hidden="true" inert>

      <div class="toc-head">
        <p class="toc-title">本文目录</p><button type="button" class="toc-close" id="article-toc-close" aria-label="关闭目录">×</button>
        <button type="button" class="toc-pin" id="article-toc-pin" aria-pressed="false" aria-label="固定目录" title="固定目录">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 17v5M9 10.8a2 2 0 0 1-1.1 1.8l-1.8.9A2 2 0 0 0 5 15.2V17h14v-1.8a2 2 0 0 0-1.1-1.8l-1.8-.9a2 2 0 0 1-1.1-1.8V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/>
          </svg>
        </button>
      </div>
      <nav>
        <ol>
          {headings.map((heading) => (
            <li class:list={[`depth-${heading.depth}`]}>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </aside>
)}

<script>
  const toc = document.getElementById('article-toc');
  const panel = document.getElementById('article-toc-panel');
  const trigger = document.getElementById('article-toc-trigger');
  const pin = document.getElementById('article-toc-pin');
  const close = document.getElementById('article-toc-close');
  if (toc && panel && trigger && pin && close) {
    // Versioned intent: old automatic/gutter pin choices must not reopen the new UI.
    const key = 'codeverse.articleToc.pin.v2';
    let state: 'collapsed' | 'temporary' | 'pinned' = 'collapsed';
    try { if (localStorage.getItem(key) === '1') state = 'pinned'; } catch {}
    let hover = false, distance = 0, previousY = scrollY, intent = 0, frame = 0;
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const headings = links.map(link => document.getElementById(link.dataset.tocLink ?? ''));
    const held = () => hover || panel.contains(document.activeElement);
    const render = () => {
      const open = state !== 'collapsed';
      toc.dataset.state = state;
      toc.classList.toggle('is-open', open);
      toc.classList.toggle('is-pinned', state === 'pinned');
      panel.inert = !open;
      panel.setAttribute('aria-hidden', String(!open));
      trigger.setAttribute('aria-expanded', String(open));
      trigger.setAttribute('aria-label', open ? '关闭文章目录' : '打开文章目录');
      pin.setAttribute('aria-pressed', String(state === 'pinned'));
      pin.setAttribute('aria-label', state === 'pinned' ? '取消固定目录' : '固定目录');
      pin.title = state === 'pinned' ? '取消固定目录' : '固定目录';
      toc.style.setProperty('--toc-opacity', String(state === 'pinned' || held() ? 1 : Math.max(0, 1 - Math.max(0, distance - 40) / 200)));
    };
    const reset = () => { distance = 0; previousY = scrollY; };
    const persist = () => { try { localStorage.setItem(key, state === 'pinned' ? '1' : '0'); } catch {} };
    const collapse = () => {
      clearTimeout(intent);
      if (panel.contains(document.activeElement)) trigger.focus({preventScroll:true});
      state = 'collapsed'; reset(); persist(); render();
    };
    const reveal = () => { clearTimeout(intent); if(state !== 'pinned') state = 'temporary'; reset(); render(); };
    trigger.addEventListener('pointerenter', event => {
      if (event.pointerType === 'mouse' && matchMedia('(hover:hover)').matches && state === 'collapsed') intent = window.setTimeout(reveal, 220);
    });
    trigger.addEventListener('pointerleave', () => clearTimeout(intent));
    trigger.addEventListener('click', event => {
      if(state !== 'collapsed') collapse();
      else { reveal(); if(event.detail === 0) close.focus({preventScroll:true}); }
    });
    close.addEventListener('click', collapse);
    panel.addEventListener('pointerenter', event => { if(event.pointerType === 'mouse') { hover = true; reset(); render(); } });
    panel.addEventListener('pointerleave', () => { hover = false; reset(); render(); });
    panel.addEventListener('focusin', () => { reset(); render(); });
    panel.addEventListener('focusout', () => { requestAnimationFrame(() => { reset(); render(); }); });
    pin.addEventListener('click', () => { state = state === 'pinned' ? 'temporary' : 'pinned'; reset(); persist(); render(); });
    toc.addEventListener('keydown', event => { if(event.key === 'Escape' && state !== 'collapsed') { event.preventDefault(); collapse(); } });
    const highlight = () => {
      const offset = (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-height')) || 64) + 24;
      let active = headings.find(h => h);
      for(const heading of headings) if(heading && heading.getBoundingClientRect().top <= offset + 8) active = heading;
      links.forEach(link => { const yes = link.dataset.tocLink === active?.id; link.classList.toggle('active', yes); if(yes) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current'); });
    };
    const update = () => {
      frame = 0;
      const delta = scrollY - previousY; previousY = scrollY;
      if(state === 'temporary') {
        if(held()) reset();
        else if(delta > 0) { distance += delta; if(distance >= 240) { state = 'collapsed'; distance = 0; } }
      }
      render(); highlight();
    };
    const schedule = () => { if(!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, {passive:true});
    window.addEventListener('resize', schedule);
    window.addEventListener('hashchange', schedule);
    window.addEventListener('pageshow', schedule);
    render(); highlight();
  }
</script>

<style>
  /* A small fixed intent target; the overlay never reserves a reading column. */
  .toc { position:fixed; inset:0 auto 0 0; z-index:30; pointer-events:none; }
  .toc-trigger { position:fixed; left:6px; top:45vh; width:44px; min-height:48px; border:1px solid var(--border); border-radius:12px; background:var(--surface); color:var(--text-1); pointer-events:auto; cursor:pointer; font-size:12px; box-shadow:var(--shadow); }
  .toc-panel { position:fixed; top:calc(var(--nav-height, 64px) + 16px); left:56px; width:min(260px,calc(100vw - 72px)); max-height:calc(100dvh - var(--nav-height, 64px) - 32px); overflow:auto; overscroll-behavior:contain; padding:1.05rem 1.1rem 1.15rem; border:1px solid var(--border); border-radius:18px; background:var(--surface); box-shadow:var(--shadow-lg); opacity:0; pointer-events:none; transform:translateX(-8px); transition:opacity .16s linear,transform .16s ease; }
  .toc.is-open .toc-panel { opacity:var(--toc-opacity,1); pointer-events:auto; transform:none; }
  .toc-close { margin-left:auto; border:0; background:transparent; color:var(--text-muted); cursor:pointer; font-size:24px; min-width:44px; min-height:44px; }
  .toc :is(button,a):focus-visible { outline:2px solid var(--primary); outline-offset:3px; }
  @media(prefers-reduced-motion:reduce) { .toc-panel { transition:none; } }

  .toc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .toc-title {
    margin: 0;
    color: var(--text-1);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .toc-pin {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition), background var(--transition);
  }

  .toc-pin:hover {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }

  .toc-pin[aria-pressed='true'] {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 16%, transparent);
  }

  .toc-pin[aria-pressed='true'] svg {
    fill: currentColor;
  }

  nav {
    margin-top: 0.75rem;
  }

  ol {
    display: grid;
    gap: 0.42rem;
    list-style: none;
  }

  li {
    min-width: 0;
  }

  li.depth-3 {
    padding-left: 0.75rem;
  }

  li.depth-4 {
    padding-left: 1.5rem;
  }

  a {
    display: block;
    padding: 0.12rem 0 0.12rem 0.7rem;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.55;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--transition), border-color var(--transition);
  }

  a:hover,
  a.active {
    border-left-color: var(--primary);
    color: var(--primary);
  }

  @media(pointer:coarse) { .toc-pin { width:44px;height:44px; } }
</style>
