---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

// footnote-label 是 GFM 自动生成的视觉隐藏标题，不应出现在目录中。
const headings = Astro.props.headings.filter(
  (heading) =>
    heading.depth >= 2 && heading.depth <= 4 && heading.slug !== 'footnote-label'
);
---

{headings.length > 1 && (
  <aside class="toc" aria-label="文章目录">
    <details open>
      <summary>本文目录</summary>
      <nav>
        <ol>
          {headings.map((heading) => (
            <li class:list={[`depth-${heading.depth}`]}>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  </aside>
)}

<script>
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const headings = tocLinks
    .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  if (headings.length > 0) {
    const activate = (id: string) => {
      tocLinks.forEach((link) => {
        const active = link.dataset.tocLink === id;
        link.classList.toggle('active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target.id) activate(visible[0].target.id);
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    headings.forEach((heading) => observer.observe(heading));
  }
</script>

<style>
  .toc {
    width: 220px;
    flex: 0 0 220px;
  }

  details {
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
  }

  summary {
    cursor: pointer;
    color: var(--text-1);
    font-size: 0.9rem;
    font-weight: 700;
  }

  nav {
    margin-top: 0.8rem;
  }

  ol {
    display: grid;
    gap: 0.5rem;
    list-style: none;
  }

  li {
    min-width: 0;
  }

  li.depth-3 {
    padding-left: 0.75rem;
  }

  li.depth-4 {
    padding-left: 1.5rem;
  }

  a {
    display: block;
    padding-left: 0.65rem;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.5;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--transition), border-color var(--transition);
  }

  a:hover,
  a.active {
    border-left-color: var(--primary);
    color: var(--primary);
  }

  @media (max-width: 980px) {
    .toc {
      width: 100%;
      flex-basis: auto;
      margin-bottom: 1.5rem;
    }

    details {
      position: static;
    }
  }
</style>
