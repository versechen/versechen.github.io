---
// Widely spaced, individually drawn blossoms: no stipple texture or particle canopy.
const blossoms = [
  [112,329,.77,-18],[176,368,.60,12],[133,205,.78,-20],[185,249,.60,9],
  [210,178,.73,15],[173,122,.85,-7],[272,216,.64,8],[310,283,.68,-15],
  [391,235,.74,8],[467,164,.76,-12],[510,104,.83,20],[523,184,.59,-6],
  [581,173,.78,13],[624,200,.74,-13],[587,268,.88,12],[519,316,.67,-18],
  [471,358,.70,5],[536,420,.73,-11],[592,366,.85,14],
];
---
<div class="sakura-tree" id="sakura-tree" aria-hidden="true">
  <svg viewBox="0 0 720 720" xmlns="http://www.w3.org/2000/svg" class="sakura-tree-art">
    <defs>
      <linearGradient id="sakura-wood" x1="0" y1="0" x2="1" y2="0">
        <stop stop-color="var(--tree-wood-light)"/><stop offset="1" stop-color="var(--tree-wood)"/>
      </linearGradient>
      <radialGradient id="sakura-daylight">
        <stop stop-color="var(--tree-halo)" stop-opacity=".55"/>
        <stop offset="1" stop-color="var(--tree-halo)" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="sakura-petal-color" x1="0" y1="0" x2=".8" y2="1">
        <stop stop-color="var(--tree-petal-light)"/>
        <stop offset="1" stop-color="var(--tree-petal)"/>
      </linearGradient>
      <path id="sakura-one-petal" d="M0 10C-11 3-12-10-4-12L0-8 4-12C12-10 11 3 0 10Z" fill="url(#sakura-petal-color)" stroke="var(--tree-petal-edge)" stroke-width=".5"/>
      <g id="sakura-bloom">
        <g fill="url(#sakura-petal-color)" stroke="var(--tree-petal-edge)" stroke-width=".65" stroke-linejoin="round">
          {[0,72,144,216,288].map(angle => <path transform={`rotate(${angle})`} d="M0 3C-11-2-18-13-12-23-9-28-3-27 0-22 4-28 10-26 13-22 18-12 11-1 0 3Z"/>)}
        </g>
        <path d="M0 1-3-9M0 1 8-4M0 1 6 8M0 1-6 8M0 1-9-3" fill="none" stroke="var(--tree-stamen)" stroke-width=".9" stroke-linecap="round" opacity=".7"/>
      </g>
    </defs>
    <ellipse cx="395" cy="654" rx="148" ry="10" fill="var(--tree-wood)" opacity=".045"/>
    <path d="M212 657Q350 641 514 656M288 669Q386 658 470 666" fill="none" stroke="var(--tree-wood)" stroke-width="1" opacity=".14"/>
    <circle cx="388" cy="300" r="274" fill="url(#sakura-daylight)"/>
    <g class="sakura-tree-breathe">
      <g id="sakura-tree-wind">
        <!-- The trunk narrows into curved, tapering limbs. Open air remains between every bough. -->
        <path d="M368 652Q391 603 377 531C367 492 366 459 377 418Q389 378 369 329C358 296 370 258 389 230L397 228C379 266 377 297 385 325Q403 372 391 419C381 460 385 496 394 530Q407 602 398 650C407 652 420 655 429 660L397 658 380 656 347 661Z" fill="url(#sakura-wood)"/>
        <path d="M383 580Q385 528 380 500M379 480Q369 450 383 418M381 363Q370 342 371 320" fill="none" stroke="var(--tree-wood-light)" stroke-width="1.4" opacity=".75"/>
        <g class="sakura-crown-side sakura-crown-left">
        <g class="sakura-bough sakura-bough-left" fill="none" stroke="var(--tree-wood)" stroke-linecap="round" stroke-linejoin="round">
          <path d="M379 455Q334 430 303 400C278 380 268 346 252 327Q215 306 190 283C163 255 144 232 133 203" stroke-width="7"/>
          <path d="M303 400Q248 400 220 377L176 347Q148 333 111 331" stroke-width="4"/>
          <path d="M369 321Q327 300 298 273C285 257 282 229 269 213Q241 186 209 177L175 125" stroke-width="5"/>
          <path d="M253 328Q241 290 210 274L184 248M294 272Q307 257 310 232M214 377 201 346M193 284Q171 280 153 265" stroke-width="2"/>
          <path d="m135 208 3-23m-28 146-20-13m87 28 1 19m30-191 1-18m64 60 18-10m-113-77-16-6m154 154-10 6" stroke-width="1.1"/>
        </g>
          {blossoms.slice(0,8).map(([x,y,scale,angle]) => <use href="#sakura-bloom" transform={`translate(${x} ${y}) rotate(${angle}) scale(${scale})`}/>)}
        </g>
        <g class="sakura-crown-side sakura-crown-right">
        <g class="sakura-bough sakura-bough-right" fill="none" stroke="var(--tree-wood)" stroke-linecap="round" stroke-linejoin="round">
          <path d="M388 393Q438 382 474 361C498 344 509 321 527 310Q566 286 589 266L623 202" stroke-width="6"/>
          <path d="M390 242Q414 201 444 181L466 162Q489 140 510 105" stroke-width="4.5"/>
          <path d="M399 235Q437 241 465 223L522 187Q551 177 581 176" stroke-width="3"/>
          <path d="M390 488Q439 466 467 445L533 418Q565 400 591 367" stroke-width="4.5"/>
          <path d="M474 361 471 338M530 309Q546 305 551 290M588 266Q615 259 636 235M468 445Q482 422 483 404M446 182Q451 161 443 145M523 187 532 163M568 388 570 367" stroke-width="1.7"/>
          <path d="m622 205 20-8m-128-93 1-16m-49 66 10-3m115 210 17-2m-71 48 10 4" stroke-width="1"/>
        </g>
          {blossoms.slice(9).map(([x,y,scale,angle]) => <use href="#sakura-bloom" transform={`translate(${x} ${y}) rotate(${angle}) scale(${scale})`}/>)}
        </g>
        <use href="#sakura-bloom" transform="translate(391 235) rotate(8) scale(.74)"/>
      </g>
    </g>
    <!-- Three reusable petal nodes. Only a deliberate breeze animates them. -->
    <g id="sakura-loose-petals">
      {[0,1,2].map(i => <g class="sakura-loose-petal" data-petal={i}><use href="#sakura-one-petal"/></g>)}
    </g>
    <use href="#sakura-one-petal" transform="translate(319 659) rotate(68) scale(.44)" opacity=".45"/>
  </svg>
</div>
