---
export interface YearStat {
  year: number;
  count: number;
}

export interface FacetStat {
  name: string;
  count: number;
}

interface Props {
  years: YearStat[];
  series: FacetStat[];
  tags: FacetStat[];
  total: number;
  /** 超过这个数量的标签默认折叠 */
  tagLimit?: number;
}

const { years, series, tags, total, tagLimit = 10 } = Astro.props;
const hiddenTagCount = Math.max(0, tags.length - tagLimit);
---

<aside class="blog-sidebar" id="blog-sidebar" aria-label="文章导航">
  <div class="sidebar-inner">
    <!-- 搜索 -->
    <div class="side-search">
      <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
      <input
        type="search"
        id="search-input"
        class="search-input"
        placeholder="搜索文章…"
        aria-label="搜索文章标题、摘要、分类、系列与标签"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-kbd" aria-hidden="true">/</kbd>
    </div>

    <!-- 归档 -->
    <nav class="side-block" aria-labelledby="side-archive-title">
      <h2 class="side-title" id="side-archive-title">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><path d="M10 12h4"/></svg>
        归档
      </h2>
      <ul class="side-list">
        <li>
          <button type="button" class="side-item is-active" data-facet="year" data-value="" aria-pressed="true">
            <span class="side-item-label">全部</span>
            <span class="side-item-count">{total}</span>
          </button>
        </li>
        {years.map((y) => (
          <li>
            <button type="button" class="side-item" data-facet="year" data-value={String(y.year)} aria-pressed="false">
              <span class="side-item-label">{y.year} 年</span>
              <span class="side-item-count">{y.count}</span>
            </button>
          </li>
        ))}
      </ul>
    </nav>

    <!-- 系列 -->
    {series.length > 0 && (
      <nav class="side-block" aria-labelledby="side-series-title">
        <h2 class="side-title" id="side-series-title">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          系列
        </h2>
        <ul class="side-list">
          {series.map((s) => (
            <li class="side-row">
              <button type="button" class="side-item" data-facet="series" data-value={s.name} aria-pressed="false">
                <span class="side-item-label">{s.name}</span>
                <span class="side-item-count">{s.count}</span>
              </button>
              <a
                href={`/blog/series/${encodeURIComponent(s.name)}`}
                class="side-jump"
                aria-label={`打开系列《${s.name}》的详情页`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- 标签 -->
    {tags.length > 0 && (
      <nav class="side-block" aria-labelledby="side-tag-title">
        <h2 class="side-title" id="side-tag-title">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 13.4 12 22l-9-9V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
          标签
        </h2>
        <div class="tag-cloud" id="tag-cloud">
          {tags.map((t, i) => (
            <button
              type="button"
              class:list={['tag-chip', { 'is-overflow': i >= tagLimit }]}
              data-facet="tag"
              data-value={t.name}
              aria-pressed="false"
              hidden={i >= tagLimit}
            >
              <span class="tag-chip-name">{t.name}</span>
              <span class="tag-chip-count">{t.count}</span>
            </button>
          ))}
        </div>
        {hiddenTagCount > 0 && (
          <button type="button" class="tag-toggle" id="tag-toggle" aria-expanded="false" aria-controls="tag-cloud">
            <span class="tag-toggle-text">展开其余 {hiddenTagCount} 个</span>
            <svg class="tag-toggle-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
        )}
      </nav>
    )}
  </div>
</aside>

<style>
  .blog-sidebar {
    grid-area: side;
  }

  .sidebar-inner {
    position: sticky;
    top: calc(var(--nav-height) + 1rem);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-height: calc(100vh - var(--nav-height) - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding-right: 0.25rem;
  }

  .sidebar-inner::-webkit-scrollbar { width: 4px; }
  .sidebar-inner::-webkit-scrollbar-thumb {
    background: var(--border-hover);
    border-radius: 999px;
  }

  /* 搜索 */
  .side-search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.65rem;
    width: 13px;
    height: 13px;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.38rem 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--text-1);
    font-family: inherit;
    font-size: 0.8rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .search-input::placeholder { color: var(--text-muted); }

  .search-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(232, 121, 164, 0.15);
  }

  .search-kbd {
    position: absolute;
    right: 0.6rem;
    padding: 0.02em 0.35em;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    pointer-events: none;
  }

  .search-input:focus ~ .search-kbd { opacity: 0; }

  .side-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.7rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .side-title svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .side-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side-row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .side-row .side-item { flex: 1; min-width: 0; }

  .side-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    width: 100%;
    padding: 0.42rem 0.6rem;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-2, var(--text-muted));
    font-family: inherit;
    font-size: 0.86rem;
    text-align: left;
    cursor: pointer;
    transition: background var(--transition), color var(--transition);
  }

  .side-item-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .side-item-count {
    flex-shrink: 0;
    min-width: 1.5em;
    padding: 0.05em 0.4em;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-align: center;
  }

  .side-item:hover {
    background: var(--surface-hover);
    color: var(--text-1);
  }

  .side-item.is-active {
    background: rgba(232, 121, 164, 0.12);
    color: var(--primary);
    font-weight: 650;
  }

  .side-item.is-active .side-item-count {
    background: var(--gradient);
    color: #fff;
  }

  .side-jump {
    display: grid;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    opacity: 0;
    transition: opacity var(--transition), color var(--transition), background var(--transition);
  }

  .side-jump svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .side-row:hover .side-jump,
  .side-jump:focus-visible {
    opacity: 1;
  }

  .side-jump:hover {
    background: var(--surface-hover);
    color: var(--primary);
  }

  /* 标签云 */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.22em 0.7em;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: all var(--transition);
  }

  /* [hidden] 的 UA 样式敌不过上面的 display，必须显式覆盖 */
  .tag-chip[hidden] { display: none; }

  .tag-chip:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .tag-chip.is-active {
    border-color: transparent;
    background: var(--gradient);
    color: #fff;
    box-shadow: 0 3px 12px rgba(232, 121, 164, 0.3);
  }

  .tag-chip-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem;
    opacity: 0.65;
  }

  .tag-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.6rem;
    padding: 0.2rem 0;
    border: none;
    background: none;
    color: var(--primary);
    font-family: inherit;
    font-size: 0.76rem;
    cursor: pointer;
  }

  .tag-toggle-icon {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--transition);
  }

  .tag-toggle[aria-expanded='true'] .tag-toggle-icon {
    transform: rotate(180deg);
  }

  @media (max-width: 900px) {
    .search-kbd { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-item,
    .tag-chip,
    .tag-toggle-icon,
    .side-jump {
      transition: none;
    }
  }
</style>
