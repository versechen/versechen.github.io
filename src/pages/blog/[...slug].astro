---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import TableOfContents from '../../components/TableOfContents.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hasMath } from '../../utils/math';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const allPosts = (await getCollection('blog'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const postIndex = allPosts.findIndex((entry) => entry.id === post.id);
const newerPost = postIndex > 0 ? allPosts[postIndex - 1] : undefined;
const olderPost = postIndex >= 0 ? allPosts[postIndex + 1] : undefined;

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage?.src}
  type="article"
  math={hasMath(post.body)}
>
  <article class="post-page">
    <!-- Post Header -->
    <header class="post-header container animate-fade-up">
      <div class="post-header-inner">
      <div class="post-toolbar">
        <a href="/blog">← 返回博客</a>
        <a
          class="post-edit"
          id="article-edit"
          hidden
          data-owner-nav
          href={`/notes?edit=${encodeURIComponent(post.id)}`}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
          </svg>
          编辑
        </a>
      </div>

      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.category && <span> · {post.data.category}</span>}
        {post.data.updatedDate && (
          <span class="updated-date">
            · 更新于 {formatDate(post.data.updatedDate)}
          </span>
        )}
      </div>

      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>

      {(post.data.tags ?? []).length > 0 && (
        <div class="post-tags">
          {(post.data.tags as string[]).map((t) => (
            <a href={`/tags/${encodeURIComponent(t)}`} class="tag tag-link">{t}</a>
          ))}
        </div>
      )}

      {post.data.heroImage && (
        <img
          src={post.data.heroImage.src}
          width={post.data.heroImage.width}
          height={post.data.heroImage.height}
          alt={post.data.title}
          class="post-hero-image"
        />
      )}
      </div>
    </header>

    <!-- Post Content -->
    <div class="container article-layout">
      <TableOfContents headings={headings} />

      <div class="article-main">
        <div class="prose animate-fade-up animate-delay-1">
          <Content />
        </div>

        <!-- Navigation -->
        <nav class="post-nav animate-fade-up animate-delay-2" aria-label="文章翻页">
          {newerPost ? (
            <a href={`/blog/${newerPost.id}`} class="post-nav-link post-nav-prev">
              <span>上一篇</span>
              <strong>{newerPost.data.title}</strong>
            </a>
          ) : <span></span>}
          {olderPost ? (
            <a href={`/blog/${olderPost.id}`} class="post-nav-link post-nav-next">
              <span>下一篇</span>
              <strong>{olderPost.data.title}</strong>
            </a>
          ) : <span></span>}
        </nav>

        <div class="post-back">
          <a href="/blog" class="btn btn-outline">← 返回博客列表</a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-page {
    padding-bottom: 4rem;
  }

  .post-header {
    padding-top: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  .post-header-inner {
    max-width: var(--prose-width);
    margin: 0 auto;
  }

  .post-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .post-toolbar a {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition), background var(--transition), border-color var(--transition);
  }

  .post-toolbar a:hover {
    color: var(--primary);
  }

  .post-edit {
    display: none;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--glass-bg);
  }

  .post-edit:not([hidden]) {
    display: inline-flex;
  }

  .post-edit:hover {
    border-color: var(--primary);
  }

  .post-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .updated-date {
    color: var(--text-muted);
  }

  .post-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 0.75rem;
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .post-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    max-width: 640px;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag-link {
    text-decoration: none;
    display: inline-block;
    transition: background .2s, color .2s, border-color .2s, transform .15s;
  }

  .tag-link:hover {
    background: var(--gradient);
    color: #fff;
    border-color: transparent;
    transform: translateY(-1px);
  }

  .post-hero-image {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-top: 2rem;
    box-shadow: var(--shadow-lg);
  }

  .article-layout {
    display: block;
  }

  .article-main {
    min-width: 0;
  }

  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-height: 92px;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--glass-bg);
    transition: border-color var(--transition), transform var(--transition);
  }

  .post-nav-link:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .post-nav-link span {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .post-nav-link strong {
    color: var(--text-1);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .post-nav-next {
    text-align: right;
  }

  .post-back {
    margin-top: 1.5rem;
    text-align: center;
  }

  :global(.copy-code-button) {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 1;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    background: rgba(15, 23, 42, 0.82);
    color: #e2e8f0;
    font-size: 0.72rem;
    line-height: 1.4;
    opacity: 0;
    transition: opacity var(--transition), background var(--transition);
  }

  :global(.prose pre:hover .copy-code-button),
  :global(.copy-code-button:focus-visible) {
    opacity: 1;
  }

  :global(.copy-code-button:hover) {
    background: rgba(232, 121, 164, 0.9);
  }

  @media (max-width: 640px) {
    .post-header {
      padding-top: 2rem;
      margin-bottom: 2rem;
    }

    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav-next {
      text-align: left;
    }

    :global(.copy-code-button) {
      opacity: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
    const code = pre.querySelector<HTMLElement>('code');
    if (!code || pre.querySelector('.copy-code-button')) return;

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-code-button';
    button.textContent = '复制';
    button.setAttribute('aria-label', '复制代码');

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.textContent = '已复制';
        window.setTimeout(() => {
          button.textContent = '复制';
        }, 1600);
      } catch {
        button.textContent = '复制失败';
        button.title = '请手动选择并复制代码';
      }
    });

    pre.append(button);
  });
</script>
