---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 年份归档，按年份倒序
const yearCounts = new Map<number, number>();
for (const post of posts) {
  const y = post.data.pubDate.getFullYear();
  yearCounts.set(y, (yearCounts.get(y) ?? 0) + 1);
}
const years = [...yearCounts.entries()]
  .map(([year, count]) => ({ year, count }))
  .sort((a, b) => b.year - a.year);

// 文章已按发布时间倒序，首次遇到某个系列/标签时记录的即是它最新一篇的时间，
// 据此让"最近还在更新"的主题排在前面。
function facetsByRecency(pick: (post: (typeof posts)[number]) => string[]) {
  const stat = new Map<string, { count: number; latest: number }>();
  for (const post of posts) {
    const time = post.data.pubDate.valueOf();
    for (const name of pick(post)) {
      const entry = stat.get(name);
      if (entry) {
        entry.count += 1;
        entry.latest = Math.max(entry.latest, time);
      } else {
        stat.set(name, { count: 1, latest: time });
      }
    }
  }
  return [...stat.entries()]
    .map(([name, v]) => ({ name, count: v.count, latest: v.latest }))
    .sort((a, b) => b.latest - a.latest || b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'));
}

const seriesList = facetsByRecency((p) => (p.data.series ? [p.data.series] : []));
const tagList = facetsByRecency((p) => p.data.tags ?? []);

// 中英文混排的粗略阅读时长
function readingMinutes(body?: string) {
  const text = (body ?? '').replace(/```[\s\S]*?```/g, ' ');
  const cjk = (text.match(/[\u4e00-\u9fa5]/g) ?? []).length;
  const words = text.replace(/[\u4e00-\u9fa5]/g, ' ').split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(cjk / 350 + words / 220));
}

const grouped = years.map(({ year }) => ({
  year,
  items: posts.filter((p) => p.data.pubDate.getFullYear() === year),
}));

function fmt(date: Date) {
  return date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
}
---

<BaseLayout title="博客" description="陈诗的技术文章与思考，可按年份、系列、标签检索">
  <div class="blog-wrap">
    <!-- 页头 -->
    <header class="blog-head">
      <h1 class="blog-head-title"><span class="gradient-text">博客</span></h1>
      <p class="blog-head-sub">
        {posts.length} 篇文章 · {years.length} 个年份 · {seriesList.length} 个系列 · {tagList.length} 个标签
      </p>
    </header>

    <div class="blog-layout">
      <div class="drawer-scrim" id="drawer-scrim" hidden></div>

      <BlogSidebar years={years} series={seriesList} tags={tagList} total={posts.length} />

      <div class="blog-main" id="blog-main">
        <!-- 结果状态：与文章列表对齐 -->
        <div class="toolbar">
          <div class="toolbar-inner">
            <button type="button" class="drawer-btn" id="drawer-open" aria-expanded="false" aria-controls="blog-sidebar">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M7 12h10"/><path d="M10 18h4"/></svg>
              筛选
              <span class="drawer-btn-dot" id="drawer-dot" hidden></span>
            </button>

            <p class="result-count" role="status" aria-live="polite">
              <strong id="vis-count">{posts.length}</strong> 篇
            </p>
          </div>

          <!-- 当前筛选条件 -->
          <div class="active-bar" id="active-bar" hidden>
            <span class="active-label">筛选：</span>
            <div class="active-chips" id="active-chips"></div>
            <button type="button" class="clear-all" id="clear-all">清除全部</button>
          </div>
        </div>

        {grouped.map(({ year, items }) => (
          <section class="year-group" data-year={String(year)} aria-labelledby={`year-${year}`}>
            <h2 class="year-head" id={`year-${year}`}>
              <span class="year-num">{year}</span>
              <span class="year-line" aria-hidden="true"></span>
              <span class="year-count">{items.length} 篇</span>
            </h2>

            <div class="post-list">
              {items.map((post) => (
                <article
                  class="post-row"
                  data-year={String(year)}
                  data-tags={(post.data.tags ?? []).join('|')}
                  data-series={post.data.series ?? ''}
                  data-search={[
                    post.data.title,
                    post.data.description,
                    post.data.category ?? '',
                    post.data.series ?? '',
                    ...(post.data.tags ?? []),
                  ]
                    .join(' ')
                    .toLowerCase()}
                >
                  <a href={`/blog/${post.id}`} class="post-link">
                    {post.data.heroImage && (
                      <div class="post-thumb">
                        <img
                          src={post.data.heroImage.src}
                          width={post.data.heroImage.width}
                          height={post.data.heroImage.height}
                          alt=""
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="post-body">
                      <div class="post-meta">
                        <time datetime={post.data.pubDate.toISOString()} class="post-date">
                          {fmt(post.data.pubDate)}
                        </time>
                        {post.data.series && (
                          <span class="chip chip-series">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                            {post.data.series}
                            {post.data.seriesOrder && <span class="chip-order">#{post.data.seriesOrder}</span>}
                          </span>
                        )}
                        <span class="post-read">约 {readingMinutes(post.body)} 分钟</span>
                      </div>
                      <h3 class="post-title">{post.data.title}</h3>
                      <p class="post-desc">{post.data.description}</p>
                      <div class="post-tags">
                        {(post.data.tags ?? []).map((t: string) => (
                          <span class="chip chip-tag">{t}</span>
                        ))}
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))}

        <p class="empty-state" id="empty-state" hidden>
          没有匹配的文章，换个关键词或
          <button type="button" class="empty-reset" id="empty-reset">清除筛选</button>
          试试。
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  type Facet = 'year' | 'series' | 'tag';

  const rows = Array.from(document.querySelectorAll<HTMLElement>('.post-row'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.year-group'));
  const facetButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-facet]'));
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const countEl = document.getElementById('vis-count');
  const emptyEl = document.getElementById('empty-state');
  const activeBar = document.getElementById('active-bar');
  const activeChips = document.getElementById('active-chips');
  const clearAllBtn = document.getElementById('clear-all');
  const emptyReset = document.getElementById('empty-reset');
  const drawerDot = document.getElementById('drawer-dot');

  const state: Record<Facet, string> & { q: string } = { year: '', series: '', tag: '', q: '' };
  const FACET_LABEL: Record<Facet, string> = { year: '年份', series: '系列', tag: '标签' };

  function readURL() {
    const sp = new URLSearchParams(location.search);
    state.year = sp.get('year') ?? '';
    state.series = sp.get('series') ?? '';
    state.tag = sp.get('tag') ?? '';
    state.q = sp.get('q') ?? '';
    if (searchInput) searchInput.value = state.q;
  }

  function writeURL(replace = false) {
    const sp = new URLSearchParams();
    if (state.year) sp.set('year', state.year);
    if (state.series) sp.set('series', state.series);
    if (state.tag) sp.set('tag', state.tag);
    if (state.q) sp.set('q', state.q);
    const qs = sp.toString();
    const url = qs ? `${location.pathname}?${qs}` : location.pathname;
    history[replace ? 'replaceState' : 'pushState'](null, '', url);
  }

  function matches(row: HTMLElement) {
    if (state.year && row.dataset.year !== state.year) return false;
    if (state.series && row.dataset.series !== state.series) return false;
    if (state.tag) {
      const tags = (row.dataset.tags ?? '').split('|').filter(Boolean);
      if (!tags.includes(state.tag)) return false;
    }
    if (state.q && !(row.dataset.search ?? '').includes(state.q.toLowerCase().trim())) return false;
    return true;
  }

  function renderActiveChips() {
    if (!activeChips || !activeBar) return;
    activeChips.textContent = '';

    const entries: Array<[Facet | 'q', string]> = [];
    (['year', 'series', 'tag'] as Facet[]).forEach((f) => {
      if (state[f]) entries.push([f, state[f]]);
    });
    if (state.q) entries.push(['q', state.q]);

    for (const [key, value] of entries) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'active-chip';
      const label = key === 'q' ? '关键词' : FACET_LABEL[key];
      chip.setAttribute('aria-label', `移除${label}筛选：${value}`);

      const text = document.createElement('span');
      text.textContent = `${label} · ${key === 'year' ? `${value} 年` : value}`;
      chip.append(text, Object.assign(document.createElement('span'), { className: 'active-chip-x', textContent: '×' }));

      chip.addEventListener('click', () => {
        if (key === 'q') {
          state.q = '';
          if (searchInput) searchInput.value = '';
        } else {
          state[key] = '';
        }
        apply();
      });
      activeChips.appendChild(chip);
    }

    const hasAny = entries.length > 0;
    activeBar.hidden = !hasAny;
    if (drawerDot) drawerDot.hidden = !(state.year || state.series || state.tag);
  }

  function syncButtons() {
    for (const btn of facetButtons) {
      const facet = btn.dataset.facet as Facet;
      const isOn = state[facet] === (btn.dataset.value ?? '');
      btn.classList.toggle('is-active', isOn);
      btn.setAttribute('aria-pressed', String(isOn));
    }
  }

  function apply(updateURL = true) {
    let visible = 0;
    for (const row of rows) {
      const show = matches(row);
      row.hidden = !show;
      if (show) visible++;
    }
    // 整年被过滤光时连年份标题一起收起，留下的年份计数跟随可见条目
    for (const group of groups) {
      const shown = Array.from(group.querySelectorAll<HTMLElement>('.post-row')).filter((r) => !r.hidden).length;
      group.hidden = shown === 0;
      const label = group.querySelector('.year-count');
      if (label) label.textContent = `${shown} 篇`;
    }

    if (countEl) countEl.textContent = String(visible);
    if (emptyEl) emptyEl.hidden = visible !== 0;
    syncButtons();
    renderActiveChips();
    if (updateURL) writeURL(true);
  }

  for (const btn of facetButtons) {
    btn.addEventListener('click', () => {
      const facet = btn.dataset.facet as Facet;
      const value = btn.dataset.value ?? '';
      state[facet] = state[facet] === value ? '' : value;
      apply();
      closeDrawer();
    });
  }

  let searchTimer = 0;
  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      state.q = searchInput.value;
      apply();
    }, 120);
  });

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      searchInput.value = '';
      state.q = '';
      apply();
    }
  });

  function resetAll() {
    state.year = state.series = state.tag = state.q = '';
    if (searchInput) searchInput.value = '';
    apply();
  }
  clearAllBtn?.addEventListener('click', resetAll);
  emptyReset?.addEventListener('click', resetAll);

  // 标签展开 / 收起
  const tagToggle = document.getElementById('tag-toggle');
  tagToggle?.addEventListener('click', () => {
    const expanded = tagToggle.getAttribute('aria-expanded') === 'true';
    tagToggle.setAttribute('aria-expanded', String(!expanded));
    document.querySelectorAll<HTMLElement>('.tag-chip.is-overflow').forEach((chip) => {
      chip.hidden = expanded;
    });
    const text = tagToggle.querySelector('.tag-toggle-text');
    const hidden = document.querySelectorAll('.tag-chip.is-overflow').length;
    if (text) text.textContent = expanded ? `展开其余 ${hidden} 个` : '收起标签';
  });

  // 移动端筛选抽屉
  const sidebar = document.getElementById('blog-sidebar');
  const drawerOpen = document.getElementById('drawer-open');
  const scrim = document.getElementById('drawer-scrim');

  function openDrawer() {
    sidebar?.classList.add('is-open');
    if (scrim) scrim.hidden = false;
    drawerOpen?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    sidebar?.querySelector<HTMLElement>('button, a')?.focus({ preventScroll: true });
  }

  function closeDrawer() {
    if (!sidebar?.classList.contains('is-open')) return;
    sidebar.classList.remove('is-open');
    if (scrim) scrim.hidden = true;
    drawerOpen?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    drawerOpen?.focus({ preventScroll: true });
  }

  drawerOpen?.addEventListener('click', () => {
    sidebar?.classList.contains('is-open') ? closeDrawer() : openDrawer();
  });
  scrim?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
    // "/" 快速聚焦搜索，但不打断正在输入的用户
    const target = e.target as HTMLElement | null;
    const typing = target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      searchInput?.focus();
    }
  });

  window.addEventListener('popstate', () => {
    readURL();
    apply(false);
  });

  readURL();
  apply(false);
</script>

<style>
  .blog-wrap {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  /* 页头 */
  .blog-head {
    padding: 3rem 0 1.5rem;
  }

  .blog-head-title {
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    margin-bottom: 0.3rem;
  }

  .blog-head-sub {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  /* 状态条：桌面随内容滚动，窄屏才吸顶以便随时打开筛选 */
  .toolbar {
    margin-bottom: 0.75rem;
    padding: 0.35rem 0;
  }

  .toolbar-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .result-count {
    flex-shrink: 0;
    color: var(--text-muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .result-count strong {
    color: var(--primary);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
  }

  /* 已选条件 */
  .active-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.6rem;
  }

  .active-bar[hidden] { display: none; }

  .active-label {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .active-chips {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .active-bar :global(.active-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15em 0.6em;
    border: 1px solid rgba(232, 121, 164, 0.3);
    border-radius: 999px;
    background: rgba(232, 121, 164, 0.1);
    color: var(--primary);
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    transition: background var(--transition);
  }

  .active-bar :global(.active-chip:hover) {
    background: rgba(232, 121, 164, 0.2);
  }

  .active-bar :global(.active-chip-x) {
    font-size: 0.95rem;
    line-height: 1;
  }

  .clear-all {
    border: none;
    background: none;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.75rem;
    text-decoration: underline;
    cursor: pointer;
  }

  .clear-all:hover { color: var(--primary); }

  /* 双栏 */
  .blog-layout {
    display: grid;
    grid-template-areas: 'side main';
    grid-template-columns: 216px minmax(0, 1fr);
    gap: 3rem;
    /* 侧栏需与主区等高，内部的 sticky 才有可粘附的范围；
       若用 align-items:start，侧栏高度只等于自身内容，sticky 会直接跟着滚走 */
    align-items: stretch;
  }

  .blog-main { grid-area: main; min-width: 0; }

  /* 年份分组 */
  .year-group { margin-bottom: 2.5rem; }
  .year-group[hidden] { display: none; }

  .year-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .year-num {
    color: var(--text-1);
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .year-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }

  .year-count {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  /* 文章行 */
  .post-list { display: flex; flex-direction: column; }
  .post-row[hidden] { display: none; }

  .post-link {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1.15rem 0.85rem;
    margin: 0 -0.85rem;
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: background var(--transition);
  }

  .post-link:hover { background: rgba(232, 121, 164, 0.05); }

  .post-row + .post-row .post-link {
    border-top: 1px solid var(--border);
    border-radius: 0;
  }

  .post-row + .post-row .post-link:hover {
    border-top-color: transparent;
    border-radius: var(--radius);
  }

  .post-thumb {
    flex-shrink: 0;
    width: 104px;
    height: 74px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .post-link:hover .post-thumb img { transform: scale(1.06); }

  .post-body { flex: 1; min-width: 0; }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }

  .post-date,
  .post-read {
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.14em 0.6em;
    border-radius: 999px;
    font-size: 0.71rem;
  }

  .chip svg {
    width: 10px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
  }

  .chip-series {
    border: 1px solid rgba(147, 51, 234, 0.2);
    background: rgba(147, 51, 234, 0.1);
    color: var(--secondary);
    font-weight: 600;
  }

  .chip-order {
    font-family: 'JetBrains Mono', monospace;
    opacity: 0.7;
  }

  .chip-tag {
    border: 1px solid rgba(147, 51, 234, 0.12);
    background: rgba(147, 51, 234, 0.07);
    color: var(--secondary);
  }

  .post-title {
    margin-bottom: 0.3rem;
    color: var(--text-1);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.45;
    transition: color var(--transition);
  }

  .post-link:hover .post-title { color: var(--primary); }

  .post-desc {
    display: -webkit-box;
    overflow: hidden;
    margin-bottom: 0.5rem;
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .post-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .empty-state {
    padding: 4rem 1rem;
    color: var(--text-muted);
    text-align: center;
    font-size: 0.9rem;
  }

  .empty-reset {
    border: none;
    background: none;
    color: var(--primary);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  /* 抽屉（仅移动端出现） */
  .drawer-btn {
    display: none;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--text-1);
    font-family: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .drawer-btn svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .drawer-btn-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
  }

  .drawer-btn-dot[hidden] { display: none; }

  .drawer-scrim { display: none; }

  @media (max-width: 900px) {
    .blog-layout {
      grid-template-areas: 'main';
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .drawer-btn { display: inline-flex; }

    .toolbar {
      position: sticky;
      top: var(--nav-height);
      z-index: 40;
      margin-bottom: 1.25rem;
      padding: 0.55rem 0;
      border-bottom: 1px solid var(--border);
      background: var(--glass-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .drawer-scrim {
      position: fixed;
      inset: 0;
      z-index: 90;
      display: block;
      background: rgba(0, 0, 0, 0.45);
