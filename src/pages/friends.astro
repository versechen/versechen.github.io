---
import CoastalScene from '../components/CoastalScene.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const friends = [
  {
    name: 'Jimmy Song',
    avatar: '🌐',
    desc: 'Cloud Native & AI Native 领域专家，CNCF Ambassador',
    url: 'https://jimmysong.io',
    tags: ['Cloud Native', 'AI'],
  },
  {
    name: 'Poetize',
    avatar: '🌸',
    desc: '最美博客，分享诗意生活与技术思考',
    url: 'https://poetize.cn',
    tags: ['生活', '技术'],
  },
  {
    name: '阮一峰的网络日志',
    avatar: '📖',
    desc: '每周分享科技动态与互联网生活，业界知名技术博主',
    url: 'https://www.ruanyifeng.com/blog',
    tags: ['技术周刊', '前端'],
  },
  {
    name: 'Josh W Comeau',
    avatar: '✨',
    desc: '深度 CSS 与前端技术文章，动效与交互设计大师',
    url: 'https://www.joshwcomeau.com',
    tags: ['CSS', '前端'],
  },
  {
    name: 'Overreacted',
    avatar: '⚛️',
    desc: 'Dan Abramov 的个人博客，React 核心开发者的深度思考',
    url: 'https://overreacted.io',
    tags: ['React', '工程'],
  },
  {
    name: 'CSS Tricks',
    avatar: '🎨',
    desc: '前端技巧、Web 设计、CSS 最佳实践资源站',
    url: 'https://css-tricks.com',
    tags: ['CSS', '设计'],
  },
];
---

<BaseLayout title="友链" description="志同道合的朋友们">
  <div class="page-hero container animate-fade-up">
      <CoastalScene />
    <h1 class="page-hero-title" data-verse="春山来信"><span class="gradient-text">友链</span></h1>
    <p class="page-hero-desc">志同道合的朋友们，欢迎互换友链</p>
  </div>

  <section class="section" style="padding-top: 1rem">
    <div class="container">
      <div class="friends-grid animate-fade-up animate-delay-1">
        {friends.map((f) => (
          <a href={f.url} class="card friend-card" target="_blank" rel="noopener noreferrer">
            <div class="friend-avatar">{f.avatar}</div>
            <div class="friend-info">
              <p class="friend-info-name">{f.name}</p>
              <p class="friend-info-desc">{f.desc}</p>
              <div class="friend-tags">
                {f.tags.map(t => <span class="tag">{t}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Apply section -->
      <div class="card apply-card animate-fade-up animate-delay-2">
        <div class="apply-icon">🤝</div>
        <div class="apply-content">
          <h3>申请友链</h3>
          <p>
            如果你也有自己的个人博客，欢迎与我互换友链！请通过邮件发送你的站点信息：
            站点名称、网址、简介和头像。我会尽快审核并添加。
          </p>
          <a href="mailto:hello@codeverse.dev" class="btn btn-primary">
            发送申请
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .friends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .friend-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .friend-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--gradient-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
    border: 2px solid var(--border);
  }

  .friend-info {
    flex: 1;
    min-width: 0;
  }

  .friend-info-name {
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.3rem;
    color: var(--text-1);
  }

  .friend-card:hover .friend-info-name {
    color: var(--primary);
  }

  .friend-info-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .friend-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  /* Apply card */
  .apply-card {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: 1rem;
    background: linear-gradient(135deg,
      rgba(232, 121, 164, 0.06) 0%,
      rgba(147, 51, 234, 0.06) 100%);
    border-color: rgba(232, 121, 164, 0.2);
  }

  .apply-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .apply-content h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .apply-content p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 640px) {
    .apply-card {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
