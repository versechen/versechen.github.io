---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { hasMath } from '../utils/math';

const bookEntries = (await getCollection('books')).sort((a, b) =>
  b.data.finishDate.localeCompare(a.data.finishDate)
);
const books = await Promise.all(
  bookEntries.map(async (book) => ({
    id: book.id,
    ...book.data,
    Content: (await render(book)).Content,
  }))
);
const needsMath = bookEntries.some((book) => hasMath(book.body));
const allBookTags = [...new Set(books.flatMap((book) => book.tags))].sort();

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}
---

<BaseLayout title="读书" description="陈诗的读书笔记与书评" math={needsMath}>

  <!-- Hero -->
  <div class="page-hero container">
    <span class="rsp rsp1" aria-hidden="true">✦</span>
    <span class="rsp rsp2" aria-hidden="true">✧</span>
    <span class="rsp rsp3" aria-hidden="true">❋</span>
    <div class="reading-hero-icon" aria-hidden="true">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
      </svg>
    </div>
    <h1 class="page-hero-title"><span class="gradient-text">读 书</span></h1>
    <p class="page-hero-desc" aria-live="polite">
      读书笔记 · 知识提炼 · 思考感想 · 显示 <strong id="book-count">{books.length}</strong> 本
    </p>
  </div>

  <!-- Book list -->
  <section class="section" style="padding-top:1rem">
    <div class="container">
      <div class="book-filters" aria-label="按标签筛选书籍">
        <button class="book-filter active" data-book-filter="" aria-pressed="true">全部</button>
        {allBookTags.map((tag) => (
          <button class="book-filter" data-book-filter={tag} aria-pressed="false">{tag}</button>
        ))}
      </div>

      <div class="book-list">
        {books.map(({ Content, ...book }) => (
          <article class="book-card" data-book-tags={book.tags.join(',')}>

            <!-- Left: cover + meta -->
            <div class="book-cover-col">
              <div class="book-cover">
                <span class="book-cover-emoji">{book.cover}</span>
                <div class="book-spine"></div>
              </div>
              <div class="book-meta-col">
                <span class="book-rating" title={`评分 ${book.rating}/5`} aria-label={`评分 ${book.rating}/5`}>{stars(book.rating)}</span>
                <span class="book-date">{book.finishDate}</span>
              </div>
            </div>

            <!-- Right: content -->
            <div class="book-body">

              <!-- Header -->
              <div class="book-header">
                <div>
                  <h2 class="book-title">{book.title}</h2>
                  <p class="book-author">by {book.author}</p>
                </div>
                <div class="book-tags">
                  {book.tags.map(t => (
                    <button class="btag" type="button" data-filter-tag={t}>{t}</button>
                  ))}
                </div>
              </div>

              <p class="book-summary">{book.summary}</p>

              <!-- Key points -->
              <div class="book-section">
                <h3 class="section-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                  核心知识点
                </h3>
                <ul class="key-points">
                  {book.keyPoints.map(pt => (
                    <li class="key-point">
                      <span class="kp-dot" aria-hidden="true"></span>
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Personal thoughts -->
              <div class="book-section">
                <h3 class="section-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  读后感
                </h3>
                <div class="book-thoughts">
                  <Content />
                </div>
              </div>

            </div>
          </article>
        ))}
      </div>
      <p id="book-empty" class="book-empty" hidden>没有匹配该标签的读书笔记。</p>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero sparkles ── */
  .page-hero { position: relative; }

  .rsp {
    position: absolute;
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: rsp-float var(--d, 5s) ease-in-out infinite;
    pointer-events: none;
    user-select: none;
  }

  .rsp1 { top: 30%; left: 6%;   font-size: 1.3rem; --d: 5s; animation-delay: 0s; }
  .rsp2 { top: 18%; right: 8%;  font-size: .85rem; --d: 7s; animation-delay: .9s; }
  .rsp3 { bottom: 18%; right: 14%; font-size: 1.1rem; --d: 6s; animation-delay: 1.6s; }

  @keyframes rsp-float {
    0%,100% { transform: translateY(0) rotate(0deg); opacity: .7; }
    50%      { transform: translateY(-14px) rotate(180deg); opacity: 1; }
  }

  .reading-hero-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    color: #fff;
    box-shadow: 0 8px 24px rgba(232,121,164,.35);
  }

  .page-hero-desc strong {
    color: var(--primary);
  }

  .book-filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.25rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .book-filter {
    flex: 0 0 auto;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: 0.8rem;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }

  .book-filter:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .book-filter.active {
    border-color: transparent;
    background: var(--gradient);
    color: #fff;
  }

  /* ── Book list ── */
  .book-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .book-empty {
    padding: 4rem 1rem;
    color: var(--text-muted);
    text-align: center;
  }

  /* ── Book card ── */
  .book-card {
    display: flex;
    gap: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: relative;
    overflow: hidden;
    transition: border-color .2s, box-shadow .2s, transform .2s;
  }

  .book-card[hidden] {
    display: none;
  }

  .book-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--gradient);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .book-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  /* ── Left column: book cover ── */
  .book-cover-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .75rem;
    flex-shrink: 0;
  }

  .book-cover {
    width: 80px;
    height: 108px;
    border-radius: 4px 10px 10px 4px;
    background: var(--gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 3px 4px 16px rgba(147,51,234,.25), inset -2px 0 6px rgba(0,0,0,.15);
    flex-shrink: 0;
  }

  .book-cover-emoji {
    font-size: 2.4rem;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,.2));
  }

  /* Book spine accent */
  .book-spine {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 8px;
    background: rgba(0,0,0,.18);
    border-radius: 4px 0 0 4px;
  }

  .book-meta-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .3rem;
  }

  .book-rating {
    font-size: .9rem;
    color: #f59e0b;
    letter-spacing: .05em;
  }

  .book-date {
    font-size: .72rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  /* ── Right column: content ── */
  .book-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .book-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .book-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-1);
    line-height: 1.2;
    margin-bottom: .2rem;
  }

  .book-author {
    font-size: .82rem;
    color: var(--text-muted);
  }

  .book-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    flex-shrink: 0;
  }

  .btag {
    font-size: .7rem;
    padding: .18em .7em;
    border-radius: 999px;
    background: rgba(147,51,234,.08);
    color: var(--secondary);
    border: 1px solid rgba(147,51,234,.15);
    text-decoration: none;
    transition: background .2s, color .2s, border-color .2s;
  }

  .btag:hover {
    background: var(--gradient);
    color: #fff;
    border-color: transparent;
  }

  .book-summary {
    font-size: .95rem;
    color: var(--text-muted);
    line-height: 1.7;
    padding-left: 1rem;
    border-left: 3px solid rgba(232,121,164,.35);
    font-style: italic;
  }

  /* ── Sections ── */
  .book-section {
    display: flex;
    flex-direction: column;
    gap: .65rem;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: .4rem;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .06em;
    color: var(--primary);
    text-transform: uppercase;
  }

  /* Key points */
  .key-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .55rem;
  }

  .key-point {
    display: flex;
    align-items: flex-start;
    gap: .65rem;
    font-size: .88rem;
    color: var(--text-1);
    line-height: 1.65;
  }

  .kp-dot {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gradient);
    margin-top: .45em;
  }

  /* Thoughts blockquote */
  .book-thoughts {
    font-size: .9rem;
    color: var(--text-muted);
    line-height: 1.8;
    padding: .9rem 1.1rem;
    border-radius: var(--radius);
    background: rgba(147,51,234,.04);
    border: 1px solid rgba(147,51,234,.1);
    border-left: 3px solid var(--secondary);
    position: relative;
  }

  .book-thoughts::before {
    content: '"';
    position: absolute;
    top: -.2rem;
    left: .6rem;
    font-size: 2.5rem;
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    opacity: .4;
  }

  :global(.book-thoughts p) {
    margin-bottom: 0.8rem;
  }

  :global(.book-thoughts p:last-child) {
    margin-bottom: 0;
  }

  :global(.book-thoughts :is(ul, ol)) {
    margin: 0.5rem 0 0.8rem 1.25rem;
  }

  :global(.book-thoughts a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .book-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.25rem;
    }

    .book-cover-col {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }

    .book-meta-col {
      flex-direction: row;
      gap: .75rem;
    }

    .book-header {
      flex-direction: column;
    }
  }
</style>

<script>
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-book-filter]')];
  const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]')];
  const bookCards = [...document.querySelectorAll<HTMLElement>('[data-book-tags]')];
  const bookCount = document.getElementById('book-count');
  const emptyState = document.getElementById('book-empty');

  const applyFilter = (tag: string) => {
    let visibleCount = 0;

    bookCards.forEach((card) => {
      const tags = card.dataset.bookTags?.split(',').filter(Boolean) ?? [];
      const visible = !tag || tags.includes(tag);
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    filterButtons.forEach((button) => {
      const active = (button.dataset.bookFilter ?? '') === tag;
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });

    if (bookCount) bookCount.textContent = String(visibleCount);
    if (emptyState) emptyState.hidden = visibleCount > 0;
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => applyFilter(button.dataset.bookFilter ?? ''));
  });

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      applyFilter(button.dataset.filterTag ?? '');
      document.querySelector('.book-filters')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
</script>
