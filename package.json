{
  "name": "codeverse",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync:projects": "node scripts/sync-github-projects.mjs",
    "check": "astro check",
    "covers:assign": "node scripts/assign-blog-covers.mjs",
    "covers:check": "node scripts/assign-blog-covers.mjs --check",
    "prebuild": "npm run covers:check",
    "build": "astro build",
    "verify": "npm run sync:projects && npm run test:sakura && npm run test:coastal && npm run test:toc && npm run test:covers && npm run test:annotations && npm run check && npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "test:annotations": "node --test tests/article-annotations.test.mjs",
    "test:toc": "node --test tests/toc-bounds.test.mjs",
    "test:covers": "node --test tests/blog-covers.test.mjs",
    "test:sakura": "node --test tests/sakura-navigation.test.mjs tests/sakura-breeze-lifecycle.test.mjs",
    "test:coastal": "node --test tests/coastal-sea.test.mjs tests/coastal-tide.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "katex": "^0.18.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "happy-dom": "20.14.6",
    "typescript": "^6.0.3"
  }
}
